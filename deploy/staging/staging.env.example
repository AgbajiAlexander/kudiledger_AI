# Copy outside the repository to /etc/kudiledger/staging.env.
# Set a real staging hostname when running on an approved host.
KUDILEDGER_DB=/var/lib/kudiledger/staging.sqlite
KUDILEDGER_REQUIRE_HTTPS=1
KUDILEDGER_PUBLIC_ORIGIN=https://staging.example.test
KUDILEDGER_MAIL_MODE=capture
KUDILEDGER_MAIL_CAPTURE_DIR=/var/lib/kudiledger/mail
KUDILEDGER_BACKUP_DIR=/var/backups/kudiledger
