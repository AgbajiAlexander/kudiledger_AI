[Unit]
Description=KudiLedger supervised staging API
After=network.target

[Service]
Type=simple
User=kudiledger
Group=kudiledger
WorkingDirectory=/opt/kudiledger/current
EnvironmentFile=/etc/kudiledger/staging.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/kudiledger/venv/bin/python -m uvicorn app.api.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kudiledger
InaccessiblePaths=/var/backups/kudiledger
CapabilityBoundingSet=
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
